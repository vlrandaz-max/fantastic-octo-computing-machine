# Apache config for the plain static production deploy (Network Solutions
# or any other Apache/Unix host). Harmless where it doesn't apply (GitHub
# Pages ignores .htaccess entirely; the WordPress shell theme serves its
# dist/ folder's real files directly, so this only adds caching there).

# Hashed assets (js/css/images) are safe to cache forever — their filename
# changes whenever the content does. index.html must never be cached, or
# a stale copy will keep pointing at a JS/CSS bundle that's since been
# deleted by a later deploy, breaking the site until a hard refresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Block public access to the archived pre-migration WordPress backup —
# it's real files sitting inside the web root (this account has no
# writable folder outside it), so without this rule they'd be directly
# reachable by URL even though nothing links to them.
<IfModule mod_rewrite.c>
  RewriteRule ^_wp_backup_20260921/ - [F,L]
</IfModule>

# SPA fallback: a request for a real route (e.g. /pine-woods, /majestic)
# that isn't a real file or directory gets index.html, and the app's own
# client-side routing (App.tsx) decides what to render. Only known route
# prefixes are rewritten here — anything else falls through to Apache's
# own 404 below, rather than being silently served as if it were valid.
# No RewriteBase — omitting it lets Apache infer it from this file's own
# directory (RewriteRule's own pattern, unlike REQUEST_URI, is matched
# relative to that directory), so the same rule works whether this is
# deployed at the site root or in a subfolder like /preview/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(gallery|homes-available|grandeur|crestwood|cambridge|stratford|madison|falcon-estates(-rochester-hills)?|majestic|heritage|pine-woods|contact-us|classic2|classic|simple)($|/) index.html [L]
</IfModule>

# A path that isn't a real file/directory and isn't one of the routes
# above (typo, an old WordPress permalink, a stale backlink, ...) now hits
# Apache's own 404 instead of silently getting index.html with a 200 —
# search engines correctly drop it instead of flagging a "soft 404". It
# still shows the app's own NotFoundPage (App.tsx renders that for any
# unmatched path) via _404.html — the same app bundle as index.html, just
# with its own <title>/description rather than the homepage's, generated
# by scripts/prerender-meta.mjs. Root-relative on purpose: this only needs
# to be correct for the real production deploy (site root), not the
# temporary /preview/ subfolder used for testing.
ErrorDocument 404 /_404.html
